<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://apple.com">
<plist version="1.0">
<dict>
    <!-- Activates the App Sandbox for the standalone application binary -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Essential for audio inputs: lets the standalone app access physical microphones/audio interfaces -->
    <key>com.apple.security.device.audio-input</key>
    <true/>

    <!-- Permits your app to use physical USB and MIDI ports for controllers -->
    <key>com.apple.security.device.usb</key>
    <true/>

    <!-- Allows user-directed file reading and writing via standard file open/save dialog sheets -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- Required for outgoing web connections (e.g., license registration, update checks) -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>